!pkg/env
!pkg/yamlfmt
!pkg/instance
!pkg/capability
!pkg/manifest
# Working-time clock (pkg/manifest imports it for bus.returns).
!pkg/clock
!pkg/shared
# The voice provider's client (speech to text, text to speech).
!pkg/elevenlabs
pkg/**/*_test.go
pkg/**/testdata
